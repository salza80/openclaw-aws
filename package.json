{
  "name": "@salza80/openclaw-aws",
  "version": "0.2.1",
  "description": "Deploy OpenClaw AI agents on AWS with a simple CLI",
  "keywords": [
    "openclaw",
    "moltbot",
    "clawdbot",
    "aws",
    "cdk",
    "chatbot",
    "ai",
    "whatsapp",
    "telegram",
    "discord",
    "claude",
    "installation",
    "setup",
    "infrastructure"
  ],
  "author": "Sally Mclean <smclean17@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/salza80/openclaw-aws#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salza80/openclaw-aws.git"
  },
  "bugs": {
    "url": "https://github.com/salza80/openclaw-aws/issues"
  },
  "type": "module",
  "bin": {
    "openclaw-aws": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-native-plugin.mjs && vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "watch": "tsc -w",
    "dev": "tsc -w",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --offline",
    "release": "changeset publish"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1163.0",
    "@aws-sdk/client-cloudformation": "^3.1161.0",
    "@aws-sdk/client-ec2": "^3.1161.0",
    "@aws-sdk/client-iam": "^3.1163.0",
    "@aws-sdk/client-kms": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-secrets-manager": "^3.1163.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@aws-sdk/credential-provider-node": "^3.972.92",
    "@aws-sdk/credential-providers": "^3.1163.0",
    "@fastify/static": "^10.1.10",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "chalk": "^6.0.1",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.9",
    "execa": "^10.2.1",
    "fastify": "^5.12.8",
    "ora": "^10.0.0",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "openclaw": "2026.11.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "openclaw": {
      "zod": "4.6.6",
      "npm": "12.2.2"
    }
  }
}
